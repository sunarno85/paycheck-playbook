# Salin file ini menjadi config.env, lalu isi.
# JANGAN pernah kirim isi file ini (terutama token) ke siapa pun, termasuk saya.

# ID Page Facebook (angka), dari /me/accounts
PAGE_ID=

# Page Access Token (bukan user token). Lihat GET_TOKEN.md
PAGE_ACCESS_TOKEN=

# Kunci API Pexels gratis: https://www.pexels.com/api/
# Catatan: penerbitan key Pexels sedang dijeda. Alternatif: Pixabay (https://pixabay.com/api/docs/)
PEXELS_API_KEY=

# Kunci API Pixabay gratis (login -> key tertera di halaman API docs)
PIXABAY_API_KEY=

# Voice Edge TTS. Alternatif: en-US-GuyNeural, en-US-JennyNeural, en-US-AndrewNeural
VOICE=en-US-AndrewNeural

# Font untuk teks di video
FONT=/system/fonts/Roboto-Bold.ttf

# Folder hasil
OUT_DIR=

# 1 = aman (tidak posting otomatis). Ubah ke 0 hanya kalau kamu sudah yakin.
DRY_RUN=1
